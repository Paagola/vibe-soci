# Dependencias
node_modules/

# Credenciales (las claves solo viven en .env; la plantilla es .env.ejemplo)
.env
.env.*
!.env.ejemplo

# Datos reales y del modo simulado: locales, piezas, fotos, imágenes generadas y exportaciones
datos/
datos-simulado/
# Votos del equipo (aprendizaje del director)
biblioteca/valoraciones.jsonl

# Archivos generados por scripts y temporales
ids.json
ids2.json
*.tmp
.DS_Store

# Paquete de revisión externa (se regenera; lleva copias de datos/)
revision-externa/
revision-externa.zip
# Copias sueltas de carpetas de la biblioteca (no son la fuente)
biblioteca/ejemplos.zip
biblioteca/referencias.zip

# Interfaz del chat compilada (npm run web:build)
web/dist/
