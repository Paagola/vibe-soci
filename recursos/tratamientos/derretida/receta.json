{
  "esquema": "tipografia/receta@1",
  "id": "derretida",
  "nombre": "Derretida",
  "version": 1,
  "estado": "APROBADO",
  "descripcion": "Gotas que cuelgan de la base de las letras y se funden con ellas; con brillo, líquido espeso (queso, chocolate, caramelo, salsa). La letra queda nítida: solo se funde su parte baja con las gotas.",
  "origen": { "autor": "ESTUDIO", "fecha": "2026-11-19", "aprobado": { "por": "Víctor (hoja de muestras del 19/11: «me gustan bastante»)", "fecha": "2026-11-19" } },
  "ficha": {
    "materiales": ["queso", "chocolate", "caramelo", "salsa", "miel", "glaseado", "helado"],
    "identidades": ["urbano", "desenfadado", "goloso", "familiar"],
    "evitar": ["platos que no se funden (sushi, ensalada, pescado)", "café o té (parece pintura)", "locales sobrios o de autor"],
    "fuentes": { "noAptas": ["alto-contraste"], "cuerpoMinimo": 56 },
    "observaciones": [
      "19/11, hoja de 10 locales: encaja donde el material está en la carta (Casa Aranda con chocolate, DAK Burger con salsa, Candamil): 3 de 10.",
      "19/11: raro en Sushita (oro que gotea sobre sushi) y en Café Albor (pintura blanca).",
      "19/11: borra el trazo fino de la «M» de Bodoni Moda itálica a tamaño real."
    ]
  },
  "parametros": {
    "gotas": { "tipo": "numero", "min": 0, "max": 1, "defecto": 0.6, "descripcion": "Cuántas letras gotean (1 = todas, algunas con dos gotas)." },
    "largo": { "tipo": "numero", "min": 0.1, "max": 1.2, "defecto": 0.8, "descripcion": "Largo de la gota más larga, en alturas de mayúscula." },
    "brillo": { "tipo": "booleano", "defecto": true, "descripcion": "Brillo de líquido espeso; sin brillo parece pintura." }
  },
  "emisores": [
    { "id": "gotas", "forma": "gota", "ancla": "base", "probabilidad": "$gotas", "segunda": 0.4, "ancho": [0.06, 0.13], "largo": { "min": 0.12, "max": "$largo", "curva": 1.7 }, "solape": 0.18, "noInvadir": true }
  ],
  "filtros": {
    "goo": [
      { "tipo": "desenfocar", "entrada": "origen", "radio": 0.04, "resultado": "b" },
      { "tipo": "alfa", "entrada": "b", "canal": "A", "a": 24, "b": -11, "conservarColor": true }
    ],
    "brillo": [
      { "tipo": "desenfocar", "entrada": "alfa", "radio": 0.035, "resultado": "relieve", "si": "brillo" },
      { "tipo": "brillo", "entrada": "relieve", "relieve": 0.04, "constante": 0.8, "exponente": 30, "luz": { "x": -1, "y": -3, "z": 3 }, "resultado": "luz", "si": "brillo" },
      { "tipo": "componer", "entrada": "luz", "con": "alfa", "operador": "dentro", "resultado": "luzDentro", "si": "brillo" },
      { "tipo": "componer", "entrada": "luzDentro", "con": "origen", "operador": "aritmetico", "k": [0, 0.7, 1, 0], "si": "brillo" }
    ]
  },
  "dibujo": {
    "grupo": [
      { "letras": true },
      { "grupo": [{ "letras": true, "franja": { "desde": 0.22, "alto": 3 } }, { "emisor": "gotas" }], "filtro": "goo" }
    ],
    "filtro": "brillo",
    "relleno": "@texto"
  }
}
