{
  "name": "estudio-contenido",
  "version": "0.1.0",
  "private": true,
  "description": "Estudio local para crear contenido creativo de restaurantes a partir de una idea y fotos reales",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "estudio": "npm run web:build && tsx --env-file-if-exists=.env src/web/arrancar.ts",
    "estudio:simulado": "ESTUDIO_SIMULAR=1 tsx --env-file-if-exists=.env src/web/arrancar.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "f1": "tsx --env-file-if-exists=.env src/herramientas/f1.ts",
    "activo": "tsx --env-file-if-exists=.env src/herramientas/prepararActivo.ts",
    "generar": "tsx --env-file-if-exists=.env src/herramientas/generarActivo.ts",
    "fidelidad": "tsx src/herramientas/fidelidad.ts",
    "combinar-luz": "tsx src/herramientas/combinarLuz.ts",
    "detalle": "tsx src/herramientas/extraerDetalle.ts",
    "carrusel": "tsx src/herramientas/carrusel.ts",
    "referencia": "tsx src/herramientas/referencia.ts",
    "comprobar-foto": "tsx --env-file-if-exists=.env src/herramientas/comprobarFoto.ts",
    "post": "tsx --env-file-if-exists=.env src/herramientas/post.ts",
    "muestras-tipo": "tsx src/herramientas/muestrasTipograficas.ts",
    "arte": "tsx --env-file-if-exists=.env src/herramientas/arte.ts",
    "lote": "tsx --env-file-if-exists=.env src/herramientas/lote.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:typecheck": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
