{
  "name": "estudio-contenido",
  "version": "0.1.0",
  "private": true,
  "description": "Estudio local para crear contenido creativo de restaurantes a partir de una idea y fotos reales",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "estudio": "tsx --env-file-if-exists=.env src/web/arrancar.ts",
    "estudio:simulado": "ESTUDIO_SIMULAR=1 tsx --env-file-if-exists=.env src/web/arrancar.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "f1": "tsx --env-file-if-exists=.env src/herramientas/f1.ts",
    "activo": "tsx --env-file-if-exists=.env src/herramientas/prepararActivo.ts",
    "generar": "tsx --env-file-if-exists=.env src/herramientas/generarActivo.ts",
    "fidelidad": "tsx src/herramientas/fidelidad.ts",
    "combinar-luz": "tsx src/herramientas/combinarLuz.ts",
    "detalle": "tsx src/herramientas/extraerDetalle.ts",
    "carrusel": "tsx src/herramientas/carrusel.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fontkit": "^2.0.4",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
