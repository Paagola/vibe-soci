<mxfile host="app.diagrams.net" type="device"><diagram id="flujo" name="1 · Flujo para crear una pieza"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="2500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flujo-1" value="Estudio de contenido · flujo para crear una pieza (solo en local)" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1200" height="40" as="geometry"/></mxCell><mxCell id="flujo-2" value="De una idea y una foto real del plato a una pieza creativa, fiel al plato y con la identidad del local. El sistema no rellena una plantilla: el director creativo recibe lo que ha gustado (biblioteca) y propone conceptos nuevos." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="40" as="geometry"/></mxCell><mxCell id="flujo-3" value="Tú (dueño o equipo)" style="swimlane;startSize=44;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#fffdf5;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="380" height="2290" as="geometry"/></mxCell><mxCell id="flujo-4" value="Estudio · web y casos de uso" style="swimlane;startSize=44;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#f8fbff;" vertex="1" parent="1"><mxGeometry x="420" y="100" width="560" height="2290" as="geometry"/></mxCell><mxCell id="flujo-5" value="Servicios externos" style="swimlane;startSize=44;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#f7fbf6;" vertex="1" parent="1"><mxGeometry x="980" y="100" width="320" height="2290" as="geometry"/></mxCell><mxCell id="flujo-6" value="Ficheros locales (datos/ y biblioteca/)" style="swimlane;startSize=44;fontStyle=1;fontSize=16;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#fcfcfc;" vertex="1" parent="1"><mxGeometry x="1300" y="100" width="360" height="2290" as="geometry"/></mxCell><mxCell id="flujo-7" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#333333;fontColor=#ffffff;strokeColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="185" y="160" width="90" height="50" as="geometry"/></mxCell><mxCell id="flujo-8" value="&lt;b&gt;1 · Alta del local (una vez)&lt;/b&gt;&lt;br&gt;nombre, ciudad, tono, colores en HEX y tipografías" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="240" width="320" height="80" as="geometry"/></mxCell><mxCell id="flujo-9" value="&lt;b&gt;Nuevo local&lt;/b&gt;&lt;br&gt;formulario · valida la marca con zod (HEX, 1–5 tonos, máx. 6 colores)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="460" height="80" as="geometry"/></mxCell><mxCell id="flujo-10" value="datos/locales/&amp;lt;slug&amp;gt;/marca.json" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="240" width="320" height="80" as="geometry"/></mxCell><mxCell id="flujo-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-7" target="flujo-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-8" target="flujo-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-13" value="guarda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-9" target="flujo-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-14" value="&lt;b&gt;2 · Nueva pieza&lt;/b&gt;&lt;br&gt;idea (10–300) · formato POST, CARRUSEL (3–5) o HISTORIA (1–3) · tipo · condiciones si es OFERTA o EVENTO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="370" width="320" height="100" as="geometry"/></mxCell><mxCell id="flujo-15" value="&lt;b&gt;Fotos reales&lt;/b&gt;&lt;br&gt;≥ 1 del plato (obligatoria) · opcionales: local, vajilla, personas, más platos&lt;br&gt;&lt;b&gt;Referencia de estilo&lt;/b&gt; opcional (pin): solo inspiración" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="320" height="110" as="geometry"/></mxCell><mxCell id="flujo-16" value="&lt;b&gt;Nueva pieza&lt;/b&gt;&lt;br&gt;sube las fotos, las copia a la pieza y valida el brief con las reglas del dominio (JPG, PNG o WEBP · máx. 10 MB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="500" width="460" height="110" as="geometry"/></mxCell><mxCell id="flujo-17" value="¿≥ 1 foto de plato, diapositivas en rango y condiciones si OFERTA o EVENTO?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="640" width="220" height="110" as="geometry"/></mxCell><mxCell id="flujo-18" value="datos/piezas/&amp;lt;id&amp;gt;/pieza.json&lt;br&gt;datos/piezas/&amp;lt;id&amp;gt;/fotos/" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="650" width="320" height="90" as="geometry"/></mxCell><mxCell id="flujo-19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-14" target="flujo-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-15" target="flujo-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-16" target="flujo-17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-22" value="No: error en el campo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-17" target="flujo-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="695"/><mxPoint x="440" y="420"/></Array></mxGeometry></mxCell><mxCell id="flujo-23" value="Sí: guarda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-17" target="flujo-18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-24" value="&lt;b&gt;3 · Proponer conceptos · Director creativo&lt;/b&gt;&lt;br&gt;trabajo en segundo plano con panel de progreso · mira las fotos y propone 3 conceptos con mecanismos distintos: composición, luz, recurso tipográfico, textos y por qué encaja" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="800" width="460" height="130" as="geometry"/></mxCell><mxCell id="flujo-25" value="&lt;b&gt;Gemini&lt;/b&gt;&lt;br&gt;visión + salida JSON&lt;br&gt;capa gratuita · respaldo si está saturado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="815" width="280" height="80" as="geometry"/></mxCell><mxCell id="flujo-26" value="&lt;b&gt;biblioteca/&lt;/b&gt;&lt;br&gt;principios.md · lo que ha gustado y lo que no&lt;br&gt;ejemplos/*.md · prompts que funcionaron&lt;br&gt;valoraciones.jsonl · tus votos" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="790" width="320" height="130" as="geometry"/></mxCell><mxCell id="flujo-27" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-17" target="flujo-24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-28" value="pide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-24" target="flujo-25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-29" value="lee" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="flujo-26" target="flujo-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1300" y="915"/><mxPoint x="940" y="915"/></Array></mxGeometry></mxCell><mxCell id="flujo-30" value="lee la marca" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#888888;" edge="1" parent="1" source="flujo-10" target="flujo-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1295" y="300"/><mxPoint x="1295" y="775"/><mxPoint x="850" y="775"/></Array></mxGeometry></mxCell><mxCell id="flujo-31" value="¿Te convence alguno?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="950" width="220" height="110" as="geometry"/></mxCell><mxCell id="flujo-32" value="muestra los 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-24" target="flujo-31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-33" value="No: pide otros 3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-31" target="flujo-24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="90" y="1005"/><mxPoint x="90" y="880"/><mxPoint x="470" y="880"/></Array></mxGeometry></mxCell><mxCell id="flujo-34" value="&lt;b&gt;4 · Director escribe el plan&lt;/b&gt;&lt;br&gt;por diapositiva: función, textos exactos en español, fotos que usa y prompt en inglés · pie, hashtags y texto alternativo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1090" width="460" height="110" as="geometry"/></mxCell><mxCell id="flujo-35" value="&lt;b&gt;Gemini&lt;/b&gt;&lt;br&gt;salida JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1105" width="280" height="80" as="geometry"/></mxCell><mxCell id="flujo-36" value="Sí: elige uno" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-31" target="flujo-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-37" value="pide" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-34" target="flujo-35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-38" value="¿Plan válido? (zod + ninguna cifra que no esté en la idea o las condiciones)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="590" y="1230" width="220" height="120" as="geometry"/></mxCell><mxCell id="flujo-39" value="pieza.json (plan)&lt;br&gt;plan.md · legible, con las fotos en orden" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="1245" width="320" height="90" as="geometry"/></mxCell><mxCell id="flujo-40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-34" target="flujo-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-41" value="No: reintenta con el error (máx. 2)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-38" target="flujo-34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="1290"/><mxPoint x="955" y="1145"/></Array></mxGeometry></mxCell><mxCell id="flujo-42" value="Sí: guarda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-38" target="flujo-39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-43" value="¿Cómo generas?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1380" width="220" height="110" as="geometry"/></mxCell><mxCell id="flujo-44" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-38" target="flujo-43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-45" value="&lt;b&gt;A mano&lt;/b&gt;&lt;br&gt;en la web de Higgsfield con Nano Banana Pro: copias el prompt de plan.md y adjuntas las fotos en ese orden" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1520" width="320" height="100" as="geometry"/></mxCell><mxCell id="flujo-46" value="&lt;b&gt;Importar imagen&lt;/b&gt;&lt;br&gt;sube la imagen y la registra como una versión más" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1530" width="460" height="80" as="geometry"/></mxCell><mxCell id="flujo-47" value="A mano" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-43" target="flujo-45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-45" target="flujo-46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-49" value="&lt;b&gt;5 · Generar&lt;/b&gt;&lt;br&gt;modal: nº de imágenes, modelo y límite del día; sin confirmar no se envía nada (modo simulado: no gasta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1390" width="460" height="90" as="geometry"/></mxCell><mxCell id="flujo-50" value="Por la API" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-43" target="flujo-49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-51" value="Sube fotos y referencias · envía con Idempotency-Key · guarda el requestId &lt;b&gt;antes&lt;/b&gt; de esperar · consulta el estado · descarga&lt;br&gt;Primero la portada; las demás la llevan como referencia de coherencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1650" width="460" height="120" as="geometry"/></mxCell><mxCell id="flujo-52" value="&lt;b&gt;Higgsfield API&lt;/b&gt;&lt;br&gt;POST /files/generate-upload-url + PUT&lt;br&gt;POST /&amp;lt;modelo&amp;gt;&lt;br&gt;GET status_url (2 s × 1,5, máx. 10 s)&lt;br&gt;Modelo intercambiable: marketing-studio/image, ideogram, grok" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="1640" width="280" height="140" as="geometry"/></mxCell><mxCell id="flujo-53" value="piezas/&amp;lt;id&amp;gt;/generadas/d&amp;lt;n&amp;gt;_v&amp;lt;k&amp;gt;.png&lt;br&gt;+ generación en pieza.json" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="1665" width="320" height="90" as="geometry"/></mxCell><mxCell id="flujo-54" value="confirmas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-49" target="flujo-51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-51" target="flujo-52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-56" value="guarda" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-51" target="flujo-53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="700" y="1800"/><mxPoint x="1295" y="1800"/><mxPoint x="1295" y="1735"/></Array></mxGeometry></mxCell><mxCell id="flujo-57" value="copia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-46" target="flujo-53"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="1570"/><mxPoint x="1305" y="1685"/></Array></mxGeometry></mxCell><mxCell id="flujo-58" value="&lt;b&gt;6 · Revisas&lt;/b&gt;&lt;br&gt;texto letra a letra · nada inventado · física · sin cajas detrás del texto · coherencia del carrusel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1810" width="320" height="100" as="geometry"/></mxCell><mxCell id="flujo-59" value="abres la imagen" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-53" target="flujo-58"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1480" y="1860"/></Array></mxGeometry></mxCell><mxCell id="flujo-60" value="¿Te gusta?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="120" y="1940" width="220" height="100" as="geometry"/></mxCell><mxCell id="flujo-61" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-58" target="flujo-60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-62" value="&lt;b&gt;Me gusta / No me gusta + motivo&lt;/b&gt;&lt;br&gt;también al pedir un cambio · el motivo es lo que aprende el sistema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="1945" width="460" height="90" as="geometry"/></mxCell><mxCell id="flujo-63" value="biblioteca/valoraciones.jsonl" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="1945" width="320" height="80" as="geometry"/></mxCell><mxCell id="flujo-64" value="Sí: valora gusta" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-60" target="flujo-62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-65" value="añade" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-62" target="flujo-63"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-66" value="aprende: el director lo lee la próxima vez" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#9673a6;strokeWidth=2;fontColor=#9673a6;" edge="1" parent="1" source="flujo-63" target="flujo-26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1660" y="1985"/><mxPoint x="1660" y="855"/></Array></mxGeometry></mxCell><mxCell id="flujo-67" value="&lt;b&gt;7 · Exportar&lt;/b&gt;&lt;br&gt;descarga en la web · 1080 × 1350 (post y carrusel) o 1080 × 1920 (historia) + pie.txt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="2070" width="460" height="80" as="geometry"/></mxCell><mxCell id="flujo-68" value="piezas/&amp;lt;id&amp;gt;/exportadas/" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;size=0.15;" vertex="1" parent="1"><mxGeometry x="1320" y="2070" width="320" height="80" as="geometry"/></mxCell><mxCell id="flujo-69" value="&lt;b&gt;Publicas a mano en Instagram&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="2300" width="320" height="60" as="geometry"/></mxCell><mxCell id="flujo-70" value="todas aprobadas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-62" target="flujo-67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-67" target="flujo-68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flujo-72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-67" target="flujo-69"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="2110"/><mxPoint x="440" y="2330"/></Array></mxGeometry></mxCell><mxCell id="flujo-73" value="&lt;b&gt;Pedir cambio «comentario»&lt;/b&gt;&lt;br&gt;el director reescribe el prompt con la imagen fallida como referencia («keep image 1 almost exactly» + cambios numerados) · máx. 3 por diapositiva" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="470" y="2190" width="460" height="100" as="geometry"/></mxCell><mxCell id="flujo-74" value="No: pide un cambio" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-60" target="flujo-73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="2240"/></Array></mxGeometry></mxCell><mxCell id="flujo-75" value="nueva versión" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flujo-73" target="flujo-51"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="955" y="2240"/><mxPoint x="955" y="1710"/></Array></mxGeometry></mxCell><mxCell id="flujo-76" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;background:#fff2cc&#x27;&gt;&amp;nbsp;amarillo&amp;nbsp;&lt;/span&gt; lo haces tú · &lt;span style=&#x27;background:#dae8fc&#x27;&gt;&amp;nbsp;azul&amp;nbsp;&lt;/span&gt; acción de la web · &lt;span style=&#x27;background:#e1d5e7&#x27;&gt;&amp;nbsp;morado&amp;nbsp;&lt;/span&gt; director creativo (IA) · &lt;span style=&#x27;background:#d5e8d4&#x27;&gt;&amp;nbsp;verde&amp;nbsp;&lt;/span&gt; servicio externo · &lt;span style=&#x27;background:#ffe6cc&#x27;&gt;&amp;nbsp;naranja&amp;nbsp;&lt;/span&gt; decisión&lt;br&gt;Línea discontinua gris: lectura · morada: aprendizaje" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="2410" width="900" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="reglas" name="2 · Qué decide el director creativo"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="reglas-1" value="Qué recibe el director creativo y qué reglas no se rompen nunca" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="reglas-2" value="El sistema no construye prompts cerrados. Le da al director el material real, la identidad del local y lo que ha gustado; el director propone. Las reglas fijas de abajo sí se comprueban siempre." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="40" as="geometry"/></mxCell><mxCell id="reglas-3" value="&lt;b&gt;Foto real del plato (obligatoria)&lt;/b&gt;&lt;br&gt;Es la lista de elementos, no el encuadre: mismos ingredientes, vajilla y mantel, nada añadido. El ángulo y la luz son nuevos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-4" value="&lt;b&gt;Fotos opcionales&lt;/b&gt;&lt;br&gt;Local, vajilla, personas, más platos. Para fondos compartidos o si el local lo pide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="225" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-5" value="&lt;b&gt;Referencia de estilo (pin)&lt;/b&gt;&lt;br&gt;Solo inspiración de luz, composición y recurso tipográfico. Nunca se publica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-6" value="&lt;b&gt;Marca del local&lt;/b&gt;&lt;br&gt;Colores en HEX, tipografías y tono. Nada de colores genéricos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="435" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-7" value="&lt;b&gt;Idea, tipo y condiciones&lt;/b&gt;&lt;br&gt;Precios, fechas y límites solo los escribe el dueño: la IA no inventa cifras." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-8" value="&lt;b&gt;Biblioteca&lt;/b&gt;&lt;br&gt;principios.md + ejemplos que gustaron + tus valoraciones recientes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="645" width="420" height="90" as="geometry"/></mxCell><mxCell id="reglas-9" value="&lt;b&gt;Director creativo&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Propone 3 conceptos con mecanismos distintos&lt;br&gt;2. Escribe el plan del concepto elegido&lt;br&gt;3. Reescribe un prompt cuando pides un cambio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="330" width="360" height="200" as="geometry"/></mxCell><mxCell id="reglas-10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-3" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-4" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-5" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-6" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-7" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-8" target="reglas-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-16" value="&lt;b&gt;Estructura que ha funcionado&lt;/b&gt; (guía, no plantilla)&lt;br&gt;&lt;br&gt;Cabecera: qué pieza, para quién, formato, «one single finished image»&lt;br&gt;PHOTO: nueva toma profesional, cámara, luz, foco y textura&lt;br&gt;CREATIVE TYPOGRAPHY: textos entre comillas y qué hacen con el plato&lt;br&gt;RULES: los negativos" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#f8fbff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="1020" y="330" width="380" height="200" as="geometry"/></mxCell><mxCell id="reglas-17" value="prompt en inglés, textos en español" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="reglas-9" target="reglas-16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reglas-18" value="&lt;b&gt;Reglas fijas (el código las comprueba o el prompt las lleva siempre)&lt;/b&gt;&lt;br&gt;• Foto y texto en una sola generación&lt;br&gt;• Sin cajas, paneles, bandas, pegatinas ni formas detrás del texto&lt;br&gt;• Sin números de diapositiva, puntos, iconos ni interfaz de Instagram&lt;br&gt;• Ninguna cifra o fecha que no esté en la idea o en las condiciones (validación del plan)&lt;br&gt;• Cada texto una vez, en español de España exacto, con tildes&lt;br&gt;• Máx. 3 cambios por diapositiva y límite de imágenes al día (coste)&lt;br&gt;• Confirmación antes de gastar; un trabajo enviado nunca se reenvía a ciegas (Idempotency-Key + requestId guardado)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="600" width="840" height="190" as="geometry"/></mxCell><mxCell id="reglas-19" value="&lt;b&gt;Mecanismos que han gustado&lt;/b&gt; (inspiran, no se repiten)&lt;br&gt;• Palabra enorme detrás del plato, tapada por él (FUEGO, «negro»)&lt;br&gt;• Letras que se enroscan en el borde del plato, por delante y por detrás («Esta noche»)&lt;br&gt;• Un elemento del plato firma el texto (la antena de la gamba escribe «Palamós»)&lt;br&gt;• El texto se transforma con el concepto: burbujas («Salud»), letras aplastadas y goteando («NO VENGAS A DIETA»), rascacielos, órbita&lt;br&gt;&lt;br&gt;&lt;b&gt;Lo que no ha gustado&lt;/b&gt;&lt;br&gt;• La misma foto con más calidad y el mismo ángulo: cero creatividad" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="790" width="1360" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="arquitectura" name="3 · Arquitectura del MVP"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arquitectura-1" value="Arquitectura del MVP: capas y puertos" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1400" height="40" as="geometry"/></mxCell><mxCell id="arquitectura-2" value="Las dependencias apuntan hacia dentro. El dominio y los casos de uso no saben si detrás hay Gemini, Higgsfield o un simulador; contenedor.ts elige los adaptadores según la configuración (.env)." style="text;html=1;fontSize=13;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1600" height="40" as="geometry"/></mxCell><mxCell id="arquitectura-3" value="&lt;b&gt;src/web · entrada&lt;/b&gt;&lt;br&gt;Express en 127.0.0.1 · rutas/ (API JSON y archivos) · trabajos.ts (segundo plano + progreso) · estimacion.ts (quedan X s)&lt;br&gt;publico/: frontend sin build · nuevo local · nueva pieza · conceptos · plan · generar · pedir cambio · votar · importar · exportar" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="900" height="110" as="geometry"/></mxCell><mxCell id="arquitectura-4" value="&lt;b&gt;src/aplicacion · casos de uso&lt;/b&gt; (uno por archivo, reciben sus dependencias)&lt;br&gt;crearLocal · crearPieza · proponerConceptos · planificarPieza · generarDiapositivas · importarImagen · corregirDiapositiva · valorarDiapositiva · exportarPieza&lt;br&gt;contextoCreativo.ts junta marca + pieza + fotos + biblioteca" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="270" width="900" height="130" as="geometry"/></mxCell><mxCell id="arquitectura-5" value="&lt;b&gt;src/dominio&lt;/b&gt;&lt;br&gt;modelos.ts: esquemas zod y tipos (Marca, Pieza, Concepto, Plan, Generacion, Valoracion)&lt;br&gt;reglas.ts: brief válido, cifras no autorizadas, límite de cambios, nombres de archivo&lt;br&gt;errores.ts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="420" height="150" as="geometry"/></mxCell><mxCell id="arquitectura-6" value="&lt;b&gt;src/puertos · interfaces&lt;/b&gt;&lt;br&gt;DirectorCreativo · GeneradorImagen · AlmacenPiezas · AlmacenLocales · BibliotecaCreativa · ProcesadorImagen" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="440" width="420" height="150" as="geometry"/></mxCell><mxCell id="arquitectura-7" value="llama" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arquitectura-3" target="arquitectura-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arquitectura-8" value="usa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arquitectura-4" target="arquitectura-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arquitectura-9" value="depende de" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arquitectura-4" target="arquitectura-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arquitectura-10" value="usa tipos" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="arquitectura-6" target="arquitectura-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arquitectura-11" value="&lt;b&gt;adaptadores/gemini&lt;/b&gt;&lt;br&gt;DirectorGemini · ClienteGemini (REST, JSON validado con zod, modelo de respaldo si el principal está saturado) · instrucciones.ts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="520" y="640" width="420" height="80" as="geometry"/></mxCell><mxCell id="arquitectura-12" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="arquitectura-11" target="arquitectura-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="680"/><mxPoint x="980" y="515"/></Array></mxGeometry></mxCell><mxCell id="arquitectura-13" value="&lt;b&gt;adaptadores/higgsfield&lt;/b&gt;&lt;br&gt;GeneradorHiggsfield · ClienteHiggsfield (subida, envío, sondeo) · modelos.ts: una estrategia por modelo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="520" y="735" width="420" height="80" as="geometry"/></mxCell><mxCell id="arquitectura-14" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="arquitectura-13" target="arquitectura-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="775"/><mxPoint x="980" y="515"/></Array></mxGeometry></mxCell><mxCell id="arquitectura-15" value="&lt;b&gt;adaptadores/simulado&lt;/b&gt;&lt;br&gt;DirectorSimulado · GeneradorSimulado: flujo completo sin claves ni gasto (pruebas e interruptor «Modo simulado»)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="830" width="420" height="80" as="geometry"/></mxCell><mxCell id="arquitectura-16" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="arquitectura-15" target="arquitectura-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="870"/><mxPoint x="980" y="515"/></Array></mxGeometry></mxCell><mxCell id="arquitectura-17" value="&lt;b&gt;adaptadores/ficheros&lt;/b&gt;&lt;br&gt;AlmacenPiezasFicheros · AlmacenLocalesFicheros · BibliotecaFicheros (JSON y Markdown)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="925" width="420" height="80" as="geometry"/></mxCell><mxCell id="arquitectura-18" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="arquitectura-17" target="arquitectura-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="965"/><mxPoint x="980" y="515"/></Array></mxGeometry></mxCell><mxCell id="arquitectura-19" value="&lt;b&gt;adaptadores/imagen&lt;/b&gt;&lt;br&gt;ProcesadorSharp: reduce para la visión, exporta 1080 px, crea marcadores simulados" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="520" y="1020" width="420" height="80" as="geometry"/></mxCell><mxCell id="arquitectura-20" value="implementa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=block;endFill=0;" edge="1" parent="1" source="arquitectura-19" target="arquitectura-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="980" y="1060"/><mxPoint x="980" y="515"/></Array></mxGeometry></mxCell><mxCell id="arquitectura-21" value="&lt;b&gt;src/contenedor.ts · raíz de composición&lt;/b&gt;&lt;br&gt;Lee la config y crea los adaptadores. En modo simulado usa los simulados. Es el único sitio que conoce las clases concretas." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#fff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="420" height="110" as="geometry"/></mxCell><mxCell id="arquitectura-22" value="&lt;b&gt;src/config.ts&lt;/b&gt;&lt;br&gt;.env validado con zod: GEMINI_API_KEY, GEMINI_MODELO (+ _RESPALDO), HF_KEY, HF_MODELO, HF_RESOLUCION, LIMITE_IMAGENES_DIA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fontSize=12;arcSize=4;fillColor=#fff;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="420" height="90" as="geometry"/></mxCell><mxCell id="arquitectura-23" value="&lt;b&gt;Equivalencia con la app SOCIETY&lt;/b&gt; (diagrama_pantallas_detalle.drawio)&lt;br&gt;• Nueva pieza ↔ S06 Idea + S07 Estética + S08 Fotos (mismo brief: formato, idea, tipo, condiciones, referencia, fotos)&lt;br&gt;• Proponer conceptos + elegir (plan) ↔ trabajo PLAN_PIEZA (Gemini, JSON, sin cifras inventadas)&lt;br&gt;• Generar ↔ trabajo IMAGEN_DIAPOSITIVA (enviar · esperar · guardar)&lt;br&gt;• Pedir cambio ↔ S09 regenerar(posicion, comentario), máx. 3&lt;br&gt;• Panel «quedan unos X s» ↔ S09 tiempo restante (D-19)&lt;br&gt;• Exportar ↔ sharp 1080 × 1350 / 1080 × 1920&lt;br&gt;• Nuevo aquí: elegir entre 3 conceptos y la biblioteca que aprende de tus votos (candidato para la app)&lt;br&gt;Mismo stack que Society-TypeScript (Node 24, TypeScript estricto, ESM, zod): los casos de uso se pueden llevar al worker." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1020" y="120" width="620" height="260" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>