# Copia este archivo como .env y rellena las claves. Sin claves, usa --simular.

# Modelos de texto y visión (Gemini): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-3.8-flash
# Si el principal está saturado (503), se usa este
GEMINI_MODELO_RESPALDO=gemini-3.5-flash
# Productor y especialistas de la orden con ESTUDIO_PRODUCTOR=si. Su respaldo es opcional.
GEMINI_MODELO_PRODUCTOR=gemini-4-hydrogen
# GEMINI_MODELO_PRODUCTOR_RESPALDO=gemini-3.8-flash
# Vía de generación del producto (decisión del 09/11/2026): imagen con Gemini de pago.
# Pon «si» SOLO cuando hayas activado la facturación de la clave en Google AI Studio / Cloud.
# Con «no», la orden única no genera por la API (pide hacerlo a mano o con --simular).
GEMINI_FACTURACION=no
# Tope acumulado de gasto en imágenes de Gemini, en USD. Lo comprueba el código ANTES de cada envío
# (un presupuesto de Google Cloud solo avisa, no corta).
GEMINI_TOPE_USD=1
GEMINI_MODELO_IMAGEN=gemini-3-pro-image

# Generador de imágenes (Higgsfield API): KEY_ID:KEY_SECRET
HF_KEY=
# marketing-studio/image · ideogram/v4.0 · xai/grok-imagine-image-2.0
HF_MODELO=marketing-studio/image
HF_RESOLUCION=4k

# Imágenes por la API al día (como D-32 en la app)
LIMITE_IMAGENES_DIA=40

# Zona horaria para el límite diario (por defecto Europe/Madrid)
# ESTUDIO_ZONA_HORARIA=Europe/Madrid
# Carpeta del modo simulado (por defecto datos-simulado/): nunca se mezcla con datos/
# ESTUDIO_DATOS_SIMULADO=datos-simulado
